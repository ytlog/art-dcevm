@@ -117,6 +117,8 @@
 #include "non_debuggable_classes.h"
 #include "obj_ptr.h"
 #include "object_lock.h"
+#include "oat_quick_method_header.h"
+#include "arch/context.h"
 #include "reflective_value_visitor.h"
 #include "runtime.h"
 #include "runtime_globals.h"
@@ -2857,9 +2859,52 @@
         return m;
       });
 
-  // Force every frame of every thread to deoptimize (any frame might have eg offsets compiled in).
-  driver_->runtime_->GetInstrumentation()->DeoptimizeAllThreadFrames();
+  // Compiled code containing an app-loader frame can embed offsets or dispatch
+  // assumptions about the evolving class. In particular, forcing unrelated
+  // boot-framework AOT frames through the interpreter during first-frame
+  // drawing has crashed on the target ART build. Instrument all stacks
+  // normally, then force deopt on physical frames containing app code,
+  // including an app method inlined into a boot-loader JIT caller.
+  {
+    struct AppFrameDeoptVisitor final : public art::StackVisitor {
+      explicit AppFrameDeoptVisitor(art::Thread* thread, art::Context* context)
+          : StackVisitor(thread, context, StackWalkKind::kIncludeInlinedFrames),
+            frames_(thread->GetInstrumentationStack()) {}
 
+      bool VisitFrame() override REQUIRES_SHARED(art::Locks::mutator_lock_) {
+        art::ArtMethod* method = GetMethod();
+        if (method == nullptr || method->IsRuntimeMethod() || method->IsNative() ||
+            GetCurrentQuickFrame() == nullptr ||
+            method->GetDeclaringClass()->GetClassLoader() == nullptr) {
+          return true;
+        }
+        const art::OatQuickMethodHeader* header = GetCurrentOatQuickMethodHeader();
+        if (header != nullptr && header->HasShouldDeoptimizeFlag()) {
+          SetShouldDeoptimizeFlag(art::DeoptimizeFlagValue::kDebug);
+        } else {
+          auto it = frames_->find(GetReturnPcAddr());
+          CHECK(it != frames_->end()) << "App quick frame missing instrumentation record: "
+                                      << method->PrettyMethod();
+          // PopInstrumentationStackFrame compares this with ART's current id.
+          // The sentinel forces this one frame without changing global state.
+          it->second.force_deopt_id_ = std::numeric_limits<uint64_t>::max();
+        }
+        return true;
+      }
+      std::map<uintptr_t, art::instrumentation::InstrumentationStackFrame>* frames_;
+    };
+    art::Thread* self = driver_->self_;
+    art::instrumentation::Instrumentation* instrumentation =
+        driver_->runtime_->GetInstrumentation();
+    art::MutexLock mu(self, *art::Locks::thread_list_lock_);
+    driver_->runtime_->GetThreadList()->ForEach([&](art::Thread* thread) {
+      instrumentation->InstrumentThreadStack(thread, /* force_deopt= */ false);
+      std::unique_ptr<art::Context> context(art::Context::Create());
+      AppFrameDeoptVisitor visitor(thread, context.get());
+      visitor.WalkStack(true);
+    });
+  }
+
   std::unordered_map<art::ObjPtr<art::mirror::Object>,
                      art::ObjPtr<art::mirror::Object>,
                      art::HashObjPtr> map;
